# ---------------------------------------------------------------------------
# 依赖目录：绝对不能进版本库
# ---------------------------------------------------------------------------
# .deps 是 `pip install --target` 装进去的（280MB+ 第三方包）。
# 没有这条，一次 `git add .` 就会把整个依赖树提交进仓库。
.deps/
.venv/
venv/
node_modules/

# Python 缓存与构建产物
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
build/
dist/

# 运行期产物
*.log
nohup.out

# ---------------------------------------------------------------------------
# 敏感与机器相关
# ---------------------------------------------------------------------------
# 本地运行期目录（可能含配置与凭据）
.openclaw/
.env
.env.*
*.pem
*.key
secrets/
*.secret

# 检查点 / 缓存等运行期状态
checkpoints/
*.visited
.coverage.sqlite
*.db
*.sqlite3

# 上次提交状态的记录文件（工具运行时写，不是源码）
.last_seen

# 大二进制与媒体：体积大且与源码无关
media/
*.zip
*.tar.gz
*.mp4
*.mov
*.psd
*.ai
*.sketch

# 编辑器 / 系统
.idea/
.vscode/
.DS_Store
Thumbs.db

# 数据库本地实例
postgres-data/
pgdata/

# ---------------------------------------------------------------------------
# 扫描报告产物：默认不进版本库，验证证据除外
# ---------------------------------------------------------------------------
# reports/ 下绝大多数是批量核验的中间产物，留三份代表性证据：
#   fp_json_v3/      最后一轮 100+ 站回源核对的 JSON 证据
#   calib_json/      校准轮 JSON 证据
#   verify_verdict.md 复核结论
reports/*
!reports/fp_json_v3/
!reports/calib_json/
!reports/verify_verdict.md

# 批量脚本生成的一次性站点清单
tools/fp_sites_*.txt
tools/run_fp_*.sh
